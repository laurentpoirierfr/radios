{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flamenco-radios.example/schemas/radios.schema.json",
  "title": "Configuration des radios flamenco",
  "description": "Liste des webradios flamenco avec leur flux et leur logo embarqué en base64.",
  "type": "object",
  "required": ["version", "generated", "categories", "stations"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version sémantique de la configuration."
    },
    "generated": {
      "type": "string",
      "format": "date",
      "description": "Date de génération (ISO 8601)."
    },
    "categories": {
      "type": "object",
      "description": "Libellés lisibles des catégories de radios.",
      "additionalProperties": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Origine des données."
    },
    "license": { "type": "object" },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/station" }
    }
  },
  "$defs": {
    "station": {
      "type": "object",
      "required": ["id", "name", "category", "description", "stream", "homepage", "country", "codec", "bitrateKbps", "genres", "logo"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Identifiant stable (slug), utilisé comme clé par l'application."
        },
        "name": { "type": "string", "description": "Nom affiché." },
        "category": {
          "type": "string",
          "enum": ["flamenco", "sevillanas-rumba", "radios-locales"],
          "description": "Catégorie de classement dans l'application."
        },
        "description": { "type": "string", "maxLength": 300, "description": "Courte description en français." },
        "stream": {
          "type": "string",
          "format": "uri",
          "description": "URL directe du flux audio (MP3/AAC/Icecast/Shoutcast)."
        },
        "homepage": { "type": "string", "format": "uri" },
        "country": { "type": "string", "minLength": 2, "description": "Code pays ISO 3166-1 alpha-2." },
        "region": { "type": "string", "description": "Région / ville d'émission." },
        "codec": { "type": "string", "enum": ["MP3", "AAC", "OGG", "HLS"] },
        "bitrateKbps": { "type": "integer", "minimum": 16, "maximum": 320 },
        "genres": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "language": { "type": "string", "description": "Langue principale (ou 'instrumental')." },
        "logo": {
          "type": "string",
          "pattern": "^data:image/(png|webp);base64,[A-Za-z0-9+/=]+$",
          "description": "Logo 128x128 embarqué en data URI base64."
        },
        "logoSourceUrl": { "type": "string", "format": "uri", "description": "URL du logo d'origine (attribution / re-téléchargement)." },
        "notes": { "type": "string", "description": "Remarques techniques (ex. chaîne TLS incomplète)." }
      },
      "additionalProperties": false
    }
  }
}
